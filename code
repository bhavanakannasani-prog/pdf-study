# ============================================================
# READ PDF
# ============================================================

def read_pdf(file):

    global pdf_text
    global chunks
    global vector_index

    if file is None:
        return "❌ Please upload a PDF first."

    try:

        reader = PdfReader(file)

        text = ""

        for page in reader.pages:

            page_text = page.extract_text()

            if page_text:
                text += page_text + "\n"

        if not text.strip():

            return (
                "❌ Could not extract text from this PDF. "
                "Try a text-based PDF."
            )

        pdf_text = text

        # Create chunks
        chunks = []

        chunk_size = 1000
        overlap = 200

        start = 0

        while start < len(text):

            end = start + chunk_size

            chunk = text[start:end].strip()

            if chunk:
                chunks.append(chunk)

            start += chunk_size - overlap

        # Create embeddings
        embeddings = embedding_model.encode(
            chunks,
            convert_to_numpy=True
        )

        embeddings = embeddings.astype(
            "float32"
        )

        dimension = embeddings.shape[1]

        vector_index = faiss.IndexFlatL2(
            dimension
        )

        vector_index.add(
            embeddings
        )

        return (
            "✅ PDF processed successfully!\n\n"
            f"📄 Pages: {len(reader.pages)}\n"
            f"📝 Characters: {len(text):,}\n"
            f"🧩 Text chunks: {len(chunks)}\n\n"
            "You can now ask questions."
        )

    except Exception as e:

        return f"❌ Error reading PDF:\n{str(e)}"


# ============================================================
# SEARCH PDF
# ============================================================

def search_pdf(question):

    if vector_index is None:

        return []

    question_embedding = embedding_model.encode(
        [question],
        convert_to_numpy=True
    )

    question_embedding = question_embedding.astype(
        "float32"
    )

    top_k = min(
        5,
        len(chunks)
    )

    distances, indices = vector_index.search(
        question_embedding,
        top_k
    )

    results = []

    for index in indices[0]:

        if 0 <= index < len(chunks):

            results.append(
                chunks[index]
            )

    return results


# ============================================================
# CHAT WITH PDF
# ============================================================

def chat_with_pdf(question):

    if not pdf_text:

        return (
            "❌ Please upload and process a PDF first."
        )

    if not question.strip():

        return (
            "❌ Please enter a question."
        )

    try:

        relevant_chunks = search_pdf(
            question
        )

        context = "\n\n---\n\n".join(
            relevant_chunks
        )

        prompt = f"""
You are a PDF Study Buddy AI.

Answer the student's question using the
provided PDF context.

IMPORTANT RULES:

1. Answer based mainly on the PDF.
2. Do not invent facts.
3. If the PDF does not contain the answer,
   say that clearly.
4. Explain concepts in simple language.
5. Give examples when helpful.
6. For exam questions, provide structured answers.

PDF CONTEXT:

{context}

STUDENT QUESTION:

{question}
"""

        response = client.chat.completions.create(

            model=MODEL,

            messages=[

                {
                    "role": "system",
                    "content":
                    "You are a helpful AI study assistant."
                },

                {
                    "role": "user",
                    "content": prompt
                }
            ],

            temperature=0.3
        )

        return response.choices[0].message.content

    except Exception as e:

        return f"❌ AI Error:\n{str(e)}"


